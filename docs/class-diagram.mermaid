classDiagram
    direction TB

    class IModule {
        <<interface>>
        +Id() const wchar_t*
        +Group() const wchar_t*
        +Title() const wchar_t*
        +Description() const wchar_t*
        +Kind() ModuleKind
        +NeedsPath() bool
        +NeedsTarget() bool
        +NeedsElevation() bool
        +ApplyLabel() const wchar_t*
        +UndoLabel() const wchar_t*
        +ApplyWarning() const wchar_t*
        +ApplyIsDanger() bool
        +SetInput(path, target) void
        +SetSelection(rows) void
        +Run(ctx, out) void
        +Apply(ctx, out) void
        +SupportsUndo() bool
        +Undo(ctx, out) void
        --added in v2.8--
        +Actions() vector~ModuleAction~
        +RunAction(ctx, actionIndex, out) void
        +RefreshAfterAction() bool
    }

    class ModuleAction {
        +label const wchar_t*
        +warning const wchar_t*
        +danger bool
        +glyph wchar_t
    }

    class ModuleRegistry {
        +Instance()$ ModuleRegistry&
        +Register(m) void
        +All() vector~IModule*~
        +Find(id) IModule*
        +Grouped() vector~GroupEntry~
    }

    class ModuleContext {
        +hwnd HWND
        +log LogSink
        +progress ProgressFn
        +cancel CancelFn
        +Log(s) void
        +Report(pct, s) void
        +Cancelled() bool
    }

    class ModuleRow {
        +c1 : wstring
        +c2 : wstring
        +c3 : wstring
        +c4 : wstring
        +sortKey : u64
        +danger : bool
        +tag : int
    }

    class ScanItem {
        +name : wstring
        +path : wstring
        +size : u64
        +category : wstring
        +risk : wstring
        +reportOnly : bool
        +hint : wstring
        +partial : bool
        --added in v2.8--
        +emptyRecycleBin : bool
        +stopServiceFirst : bool
    }

    class CleanReport {
        <<cleanresult.h, added v2.8>>
        +freedBytes : u64
        +fileOk : int
        +fileFail : int
        +rebootPending : int
        +fails vector~CleanFileResult~
        +ErrorTextZh(code)$ wstring
    }

    class CleanerEngine {
        <<cleaner.cpp refactored v2.8>>
        +RunScan(kind, opt, progress, cancel) ScanOutcome
        +DeleteFileSmart(path, cancel, report) DeleteStatus
        +CleanDirectoryContentsEx(dir, cancel, report) u64
        +EmptyRecycleBinSafe(root, report) bool
        -tryDeleteWithAttr() bool
        -retryWithBackoff() bool
        -scheduleRebootDelete() bool
    }

    class ProcessRunner {
        <<procrun.h, added v2.8>>
        +RunProcess(cmdline, opt, fullOut)$ int
        -readThread : thread
        -waitThread : thread
    }

    class ProcRunOptions {
        +timeoutMs : int
        +cancel : CancelFn
        +onLine : function
    }

    class SysProcessMgrMod {
        <<sys.process extended>>
        -pids_ vector~DWORD~
        +RunAction(ctx, 0, out) void
        -TerminateSelected(ctx, out) void
        -IsProtected(name)$ bool
    }

    class SysSvcMgrMod {
        <<sys.services extended>>
        -names_ vector~wstring~
        +Actions() vector~ModuleAction~
        +RunAction(ctx, idx, out) void
        -StartOrStop(op) void
        -SetStartType(type) void
    }

    class SysTaskMgrMod {
        <<sys.tasks added>>
        -taskPaths_ vector~wstring~
        +Run(ctx, out) void
        +RunAction(ctx, idx, out) void
        -RunTask() void
        -StopTask() void
        -SetEnabled(on) void
        -DeleteTask() void
    }

    class SecRepairMod {
        <<sec.repair added>>
        +Actions() vector~ModuleAction~
        +RunAction(ctx, idx, out) void
        -RunRepair(cmdline) void
    }

    class AppWindow {
        -StartWork(apply, undo, actionIndex) void
        -ApplyModuleToUi() void
        -OnWorkDone() void
        -ShowMoreActionsMenu() void
    }

    IModule <|.. ModuleRegistry : registers
    IModule ..> ModuleContext : runtime injection
    IModule ..> ModuleRow : result rows
    IModule ..> ModuleAction : extended actions (v2.8)
    SysProcessMgrMod ..|> IModule
    SysSvcMgrMod ..|> IModule
    SysTaskMgrMod ..|> IModule
    SecRepairMod ..|> IModule
    CleanerEngine ..> ScanItem : produces
    CleanerEngine ..> CleanReport : per-file results
    ProcessRunner ..> ProcRunOptions : config
    SecRepairMod ..> ProcessRunner : long-running tasks
    AppWindow ..> IModule : routes Run/Apply/Undo/RunAction
    AppWindow ..> ModuleAction : more-actions menu
